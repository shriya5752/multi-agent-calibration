# Copy this file to .env and fill in your key.
# Groq offers a free tier and works well for this project:
# https://console.groq.com -> API Keys
LLM_API_KEY=your_api_key_here

# Default points at Groq's OpenAI-compatible endpoint.
# To use OpenAI instead: https://api.openai.com/v1
# To use another OpenAI-compatible provider, change this.
LLM_BASE_URL=https://api.groq.com/openai/v1
